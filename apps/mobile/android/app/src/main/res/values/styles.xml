<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 웹 화면이 밝은 색뿐이라 밝은 테마로 고정. 웹이 그려지기 전 바탕은 크림, 웹뷰가 오래돼 상태바·아래 막대만큼 여백을 둘 때 그 여백은 흰색 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/launch_cream</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- 실행 화면: 크림 바탕 가운데 기억해U 로고(drawable-nodpi/splash_icon.png, 스크립트 make-assets.mjs가 그린다).
             Android 12+ 시스템 스플래시는 아이콘 자리가 가운데 지름 192dp 원이라 로고를 그 안에 맞춰 두었고, 웹 로딩 덮개도 안드로이드 앱에서는 같은 크기·자리로 이어받는다 -->
        <item name="windowSplashScreenBackground">@color/launch_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>